{
  "name": "epub-reader",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./client --filter ./server dev",
    "build": "pnpm --parallel --filter ./client --filter ./server build",
    "start": "pnpm --filter ./server start",
    "lint": "pnpm --parallel --filter ./client --filter ./server lint",
    "typecheck": "pnpm --parallel --filter ./client --filter ./server typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
